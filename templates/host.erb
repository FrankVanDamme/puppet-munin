# File Managed by Puppet
 
<% if scope['networking']['fqdn'] -%>
[<%= @folder_prefix %><%= scope['networking']['fqdn'] %>]
<% else -%>
[<%= @folder_prefix %><%= scope['networking']['hostname'] %>]
<% end -%>
    address <%= scope.lookupvar('munin::address') %>
    port <%= scope.lookupvar('munin::port') %>
    use_node_name yes
